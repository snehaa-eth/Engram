# Copy this file to .env and fill in what you use. Never commit .env.

# LLM for fact extraction and consolidation: gemini | claude | fake (free, rule-based)
ENGRAM_LLM=gemini
# Embeddings: gemini | hash (free, keyword-only)
ENGRAM_EMBEDDER=gemini

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
# ENGRAM_GEMINI_MODEL=gemini-2.5-flash
# ENGRAM_GEMINI_EMBED_MODEL=gemini-embedding-001
# ENGRAM_CLAUDE_MODEL=claude-haiku-5-5
# ENGRAM_EMBED_DIM=768
# ENGRAM_DB=engram.db
# ENGRAM_TOKEN_BUDGET=600
# ENGRAM_CACHE=1

# HTTP API keys -> tenant, e.g. "key-for-acme:acme,key-for-globex:globex"
# ENGRAM_API_KEYS=
